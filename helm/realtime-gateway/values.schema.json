{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "gateway", "redis", "resources"],
  "additionalProperties": true,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["allowedOrigins", "trustedNetworks", "shutdownDrainSeconds"],
      "properties": {
        "shutdownDrainSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "allowedOrigins": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "trustedNetworks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "redis": {
      "type": "object",
      "required": ["mode", "externalEndpoint", "managedReleaseName", "credentialsSecret", "instancePrefix"],
      "properties": {
        "mode": { "enum": ["external", "managed"] },
        "externalEndpoint": { "type": "string" },
        "managedReleaseName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "aclProvisionerImage": { "type": "string", "pattern": "^[^@]+@sha256:[a-f0-9]{64}$" },
        "credentialsSecret": {
          "type": "object",
          "required": ["name", "usernameKey", "passwordKey"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "external" } } }, "then": { "properties": { "externalEndpoint": { "minLength": 1 } } } }
      ]
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "gateway", "redis", "resources"],
  "additionalProperties": true,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      }
    },
    "ingressRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" },
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
        "tlsSecretName": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["host", "path", "tlsSecretName"], "properties": { "host": { "minLength": 1 }, "tlsSecretName": { "minLength": 1 } } }
        }
      ]
    },
    "gateway": {
      "type": "object",
      "required": ["allowedOrigins", "trustedNetworks", "shutdownDrainSeconds"],
      "properties": {
        "shutdownDrainSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "allowedOrigins": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "trustedNetworks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "redis": {
      "type": "object",
      "required": ["mode", "externalEndpoint", "managedReleaseName", "credentialsSecret", "instancePrefix", "username", "sentinelPort", "sentinelServiceName", "managedAdminPasswordKey"],
      "properties": {
        "mode": { "enum": ["external", "managed"] },
        "externalEndpoint": { "type": "string" },
        "managedReleaseName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sentinelPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sentinelServiceName": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "managedAdminPasswordKey": { "type": "string", "minLength": 1 },
        "credentialsSecret": {
          "type": "object",
          "required": ["name", "passwordKey"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "external" } } }, "then": { "properties": { "externalEndpoint": { "minLength": 1 } } } }
      ]
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "connectionsMetric": { "type": "object", "required": ["enabled", "targetAverageValue"], "properties": { "enabled": { "type": "boolean" }, "targetAverageValue": { "type": "string", "pattern": "^[1-9][0-9]*$" } } },
        "queueDepthMetric": { "type": "object", "required": ["enabled", "targetAverageValue"], "properties": { "enabled": { "type": "boolean" }, "targetAverageValue": { "type": "string", "pattern": "^[1-9][0-9]*$" } } }
      }
    },
    "observability": {
      "type": "object",
      "required": ["environment", "platformMetrics", "alertThresholds", "links", "serviceMonitor", "grafanaDashboard", "prometheusRule", "alertmanagerConfig"],
      "properties": {
        "environment": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "platformMetrics": { "type": "object", "required": ["certificateName", "metalLbAdvertisementMode", "metalLbNamespace", "traefikNamespace", "traefikServicePattern"], "properties": { "certificateName": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "metalLbAdvertisementMode": { "type": "string", "enum": ["l2", "bgp"] }, "metalLbNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "traefikNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "traefikServicePattern": { "type": "string", "pattern": "^[A-Za-z0-9._@*|:-]*$", "maxLength": 253 } } },
        "alertThresholds": { "type": "object", "required": ["queueDepth", "handlerLatencySeconds", "redisLatencySeconds", "reconnectRatio"], "properties": { "queueDepth": { "type": "integer", "minimum": 1 }, "handlerLatencySeconds": { "type": "number", "exclusiveMinimum": 0 }, "redisLatencySeconds": { "type": "number", "exclusiveMinimum": 0 }, "reconnectRatio": { "type": "number", "exclusiveMinimum": 0 } } },
        "links": { "type": "object", "required": ["logsUrl", "tracesUrl", "kubernetesUrl", "runbookBaseUrl"], "properties": { "logsUrl": { "type": "string", "format": "uri" }, "tracesUrl": { "type": "string", "format": "uri" }, "kubernetesUrl": { "type": "string", "format": "uri" }, "runbookBaseUrl": { "type": "string", "format": "uri" } } },
        "serviceMonitor": { "type": "object", "required": ["enabled", "interval", "scrapeTimeout"], "properties": { "enabled": { "type": "boolean" }, "interval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" }, "scrapeTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" } } },
        "grafanaDashboard": { "type": "object", "required": ["enabled", "label", "labelValue"], "properties": { "enabled": { "type": "boolean" }, "label": { "type": "string", "minLength": 1 }, "labelValue": { "type": "string", "minLength": 1 } } },
        "prometheusRule": { "type": "object", "required": ["enabled", "routingLabels"], "properties": { "enabled": { "type": "boolean" }, "routingLabels": { "type": "object", "required": ["service"], "properties": { "service": { "type": "string" } }, "additionalProperties": { "type": "string", "minLength": 1 } } } },
        "alertmanagerConfig": { "type": "object", "required": ["enabled", "receiverName", "webhookSecret"], "properties": { "enabled": { "type": "boolean" }, "receiverName": { "type": "string", "minLength": 1 }, "webhookSecret": { "type": "object", "required": ["name", "key"], "properties": { "name": { "type": "string" }, "key": { "type": "string", "minLength": 1 } } } } }
      }
    }
  }
}

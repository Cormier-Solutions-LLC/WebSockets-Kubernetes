{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "title": "Logs", "type": "link", "url": "__LOGS_URL__" },
    { "title": "Traces", "type": "link", "url": "__TRACES_URL__" },
    { "title": "Pods", "type": "link", "url": "__KUBERNETES_URL__" },
    { "title": "Runbooks", "type": "link", "url": "__RUNBOOK_URL__" }
  ],
  "panels": [
    { "id": 1, "title": "Available instances", "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }, "targets": [{ "expr": "sum(up{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$instance\"})", "legendFormat": "available" }] },
    { "id": 2, "title": "Active connections", "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 }, "targets": [{ "expr": "sum(cormier_realtime_active_connections{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$instance\"})", "legendFormat": "active" }] },
    { "id": 3, "title": "Peak connections", "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }, "targets": [{ "expr": "sum(cormier_realtime_peak_connections{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$instance\"})", "legendFormat": "peak" }] },
    { "id": 4, "title": "Message throughput", "type": "timeseries", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }, "targets": [{ "expr": "sum by (direction,outcome) (rate(cormier_realtime_messages_total{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{direction}} {{outcome}}" }] },
    { "id": 5, "title": "Replica readiness", "type": "timeseries", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }, "targets": [{ "expr": "sum(kube_pod_status_ready{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\",condition=\"true\"})", "legendFormat": "ready" }] },
    { "id": 6, "title": "Connection lifecycle and duration", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 4 }, "targets": [{ "expr": "sum(rate(cormier_realtime_connections_opened_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "opened" }, { "expr": "sum by (reason) (rate(cormier_realtime_connections_closed_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "closed {{reason}}" }, { "expr": "histogram_quantile(0.95,sum by (le) (rate(cormier_realtime_connection_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "duration p95" }] },
    { "id": 7, "title": "Handshake, authentication, authorization", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 4 }, "targets": [{ "expr": "sum by (outcome,reason) (rate(cormier_realtime_handshakes_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "handshake {{outcome}} {{reason}}" }, { "expr": "sum by (method,outcome) (rate(cormier_realtime_authentication_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "auth {{method}} {{outcome}}" }, { "expr": "sum by (operation) (rate(cormier_realtime_authorization_failures_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "authorization {{operation}}" }] },
    { "id": 8, "title": "Close codes and heartbeat", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 4 }, "targets": [{ "expr": "sum by (code) (rate(cormier_realtime_websocket_closes_total{cluster=~\"$cluster\",namespace=~\"$namespace\",code!=\"\"}[$__rate_interval]))", "legendFormat": "close {{code}}" }, { "expr": "sum(rate(cormier_realtime_heartbeat_timeouts_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "heartbeat timeout" }] },
    { "id": 9, "title": "Handler latency p50/p95/p99", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 11 }, "targets": [{ "expr": "histogram_quantile(0.50,sum by (le) (rate(cormier_realtime_handler_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p50" }, { "expr": "histogram_quantile(0.95,sum by (le) (rate(cormier_realtime_handler_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p95" }, { "expr": "histogram_quantile(0.99,sum by (le) (rate(cormier_realtime_handler_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p99" }] },
    { "id": 10, "title": "Queue depth, drops, slow consumers", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 11 }, "targets": [{ "expr": "sum(cormier_realtime_queue_depth{cluster=~\"$cluster\",namespace=~\"$namespace\"})", "legendFormat": "depth" }, { "expr": "sum(rate(cormier_realtime_queue_dropped_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "drops" }, { "expr": "sum(rate(cormier_realtime_slow_consumer_disconnects_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "slow consumers" }] },
    { "id": 11, "title": "Redis operations, subscription, and latency", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 11 }, "targets": [{ "expr": "sum by (operation,outcome) (rate(cormier_realtime_redis_operations_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{outcome}}" }, { "expr": "min(cormier_realtime_redis_subscription_active{cluster=~\"$cluster\",namespace=~\"$namespace\"})", "legendFormat": "subscription" }, { "expr": "histogram_quantile(0.99,sum by (le,operation) (rate(cormier_realtime_redis_operation_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "{{operation}} p99" }] },
    { "id": 12, "title": "CPU, memory, throttling", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 }, "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\"}[$__rate_interval]))", "legendFormat": "cpu" }, { "expr": "sum(container_memory_working_set_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\"})", "legendFormat": "memory" }, { "expr": "sum(rate(container_cpu_cfs_throttled_seconds_total{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "throttled" }] },
    { "id": 13, "title": "Pod restarts and rollout", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 18 }, "targets": [{ "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "{{pod}} restarts" }, { "expr": "kube_deployment_status_replicas_unavailable{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "unavailable" }] },
    { "id": 14, "title": "Traefik upgrades and HTTP errors", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 18 }, "targets": [{ "expr": "sum by (code) (rate(traefik_service_requests_total{cluster=~\"$cluster\",namespace=~\"$namespace\",code=~\"4..|5..\"}[$__rate_interval]))", "legendFormat": "HTTP {{code}}" }, { "expr": "sum(rate(traefik_service_open_connections{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "upgrades" }] },
    { "id": 15, "title": "Redis resources, replication, persistence", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 25 }, "targets": [{ "expr": "redis_memory_used_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "memory" }, { "expr": "redis_connected_slaves{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "replicas" }, { "expr": "redis_connected_clients{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "clients" }, { "expr": "redis_master_link_up{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "primary link" }, { "expr": "redis_rdb_last_bgsave_status{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "RDB save" }] },
    { "id": 16, "title": "MetalLB address and traffic", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 25 }, "targets": [{ "expr": "metallb_k8s_client_config_stale_bool{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "config stale" }, { "expr": "rate(metallb_speaker_announced_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "announcements" }] },
    { "id": 17, "title": "Certificate expiry", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 25 }, "targets": [{ "expr": "(certmanager_certificate_expiration_timestamp_seconds{cluster=~\"$cluster\",namespace=~\"$namespace\"}-time())/86400", "legendFormat": "{{name}} days" }] },
    { "id": 18, "title": "Redis Streams lag, pending, ack, recovery", "type": "timeseries", "gridPos": { "h": 7, "w": 24, "x": 0, "y": 32 }, "targets": [{ "expr": "redis_stream_group_lag{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "{{stream}} lag" }, { "expr": "redis_stream_group_pending_messages{cluster=~\"$cluster\",namespace=~\"$namespace\"}", "legendFormat": "{{stream}} pending" }, { "expr": "rate(redis_stream_messages_acked_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "acks" }, { "expr": "rate(redis_stream_messages_claimed_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "recovered" }] }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["realtime", "websocket", "kubernetes"],
  "templating": { "list": [
    { "name": "environment", "label": "Environment", "type": "custom", "query": "development,staging,production", "current": { "text": "development", "value": "development" } },
    { "name": "cluster", "label": "Cluster", "type": "query", "query": "label_values(up,cluster)", "includeAll": true, "allValue": ".*" },
    { "name": "namespace", "label": "Namespace", "type": "query", "query": "label_values(up{cluster=~\"$cluster\"},namespace)", "includeAll": true, "allValue": ".*" },
    { "name": "instance", "label": "Instance", "type": "query", "query": "label_values(up{cluster=~\"$cluster\",namespace=~\"$namespace\"},instance)", "includeAll": true, "allValue": ".*" },
    { "name": "pod", "label": "Pod", "type": "query", "query": "label_values(kube_pod_info{cluster=~\"$cluster\",namespace=~\"$namespace\"},pod)", "includeAll": true, "allValue": ".*" }
  ] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Realtime Gateway Production Diagnostics",
  "uid": "realtime-gateway-production",
  "version": 1
}

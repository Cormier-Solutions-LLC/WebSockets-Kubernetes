<Project>
  <PropertyGroup>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">0.1.0</ApplicationVersion>
    <ContainerVersion Condition="'$(ContainerVersion)' == ''">0.1.0</ContainerVersion>
    <ContractsVersion Condition="'$(ContractsVersion)' == ''">1.0.1-beta</ContractsVersion>
    <RedisAdapterVersion Condition="'$(RedisAdapterVersion)' == ''">1.0.1-beta</RedisAdapterVersion>
    <AspNetCoreIntegrationVersion Condition="'$(AspNetCoreIntegrationVersion)' == ''">1.0.1-beta</AspNetCoreIntegrationVersion>
    <DotNetClientVersion Condition="'$(DotNetClientVersion)' == ''">1.0.1-beta</DotNetClientVersion>
    <BrowserPackageVersion Condition="'$(BrowserPackageVersion)' == ''">1.0.1-beta</BrowserPackageVersion>
    <HelmChartVersion Condition="'$(HelmChartVersion)' == ''">0.1.0</HelmChartVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <Authors>Cormier</Authors>
    <Company>Cormier Solutions LLC</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl Condition="'$(PackageRepositoryUrl)' != ''">$(PackageRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotesUrl)' != ''">$(PackageReleaseNotesUrl)</PackageReleaseNotes>
    <ContractsVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(ContractsVersion)', '[-+].*$', ''))</ContractsVersionCore>
    <ContractsCompatibilityUpperBound Condition="'$(ContractsCompatibilityUpperBound)' == ''">$([System.Version]::Parse('$(ContractsVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(ContractsVersionCore)').Minor), 1)).0</ContractsCompatibilityUpperBound>
    <RedisAdapterVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(RedisAdapterVersion)', '[-+].*$', ''))</RedisAdapterVersionCore>
    <RedisAdapterCompatibilityUpperBound Condition="'$(RedisAdapterCompatibilityUpperBound)' == ''">$([System.Version]::Parse('$(RedisAdapterVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(RedisAdapterVersionCore)').Minor), 1)).0</RedisAdapterCompatibilityUpperBound>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Import Project=".bootstrap/naming.props" Condition="Exists('.bootstrap/naming.props')" />
</Project>

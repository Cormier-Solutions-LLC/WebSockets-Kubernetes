<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>$(BrowserPackageVersion)</VersionPrefix>
    <IsPackable>true</IsPackable>
    <PackageId>Cormier.Realtime.Browser</PackageId>
    <Description>Static web assets for the Cormier.Realtime browser and TypeScript client.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>websocket;realtime;browser;typescript;static-web-assets</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="SyncGeneratedBrowserAssets" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_GeneratedBrowserAsset Include="..\..\sdk\typescript\dist\**\*" />
    </ItemGroup>
    <MakeDir Directories="wwwroot" />
    <Copy SourceFiles="@(_GeneratedBrowserAsset)"
          DestinationFiles="@(_GeneratedBrowserAsset->'wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

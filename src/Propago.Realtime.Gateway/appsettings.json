{
  "Gateway": {
    "ServiceName": "propago-realtime-gateway",
    "ShutdownDrainSeconds": 25,
    "DetailedHealthChecks": false
  },
  "Redis": {
    "Endpoint": "localhost:6379",
    "InstancePrefix": "propago:realtime",
    "RequiredForReadiness": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

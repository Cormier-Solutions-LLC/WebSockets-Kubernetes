{
  "contractVersion": "1.0.0",
  "compatibility": {
    "additive": "New optional series or bounded label values require a minor version.",
    "breaking": "Renames, removals, type/unit changes, or label changes require a major version and a documented migration window.",
    "deprecationWindow": "At least one minor release with an alias, warning, and changelog entry before removal."
  },
  "metrics": [
    {
      "name": "cormier_realtime_active_connections",
      "description": "Current WebSocket connections.",
      "type": "gauge",
      "unit": "connections",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "gateway connection registry",
      "aggregation": "sum across instances",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["capacity dashboard", "availability alerts"]
    },
    {
      "name": "cormier_realtime_peak_connections",
      "description": "Peak WebSocket connections since process start.",
      "type": "gauge",
      "unit": "connections",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "gateway connection registry",
      "aggregation": "max across instances",
      "temporality": "process lifetime",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["capacity dashboard"]
    },
    {
      "name": "cormier_realtime_active_subscriptions",
      "description": "Current authorized subscriptions.",
      "type": "gauge",
      "unit": "subscriptions",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "gateway connection registry",
      "aggregation": "sum across instances",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["capacity dashboard"]
    },
    {
      "name": "cormier_realtime_queue_depth",
      "description": "Current queued outbound messages.",
      "type": "gauge",
      "unit": "messages",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "bounded outbound queues",
      "aggregation": "sum across instances",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["backpressure dashboard", "queue alerts"]
    },
    {
      "name": "cormier_realtime_queue_peak_depth",
      "description": "Peak queued outbound messages since process start.",
      "type": "gauge",
      "unit": "messages",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "bounded outbound queues",
      "aggregation": "max across instances",
      "temporality": "process lifetime",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["backpressure dashboard"]
    },
    {
      "name": "cormier_realtime_messages_total",
      "description": "Accepted, sent, and rejected protocol messages.",
      "type": "counter",
      "unit": "messages",
      "labels": ["direction", "outcome"],
      "cardinalityBudget": 16,
      "source": "protocol dispatcher",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["throughput dashboard", "protocol alerts"]
    },
    {
      "name": "cormier_realtime_connections_opened_total",
      "description": "Accepted WebSocket connections.",
      "type": "counter",
      "unit": "connections",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "gateway connection registry",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["connection dashboard"]
    },
    {
      "name": "cormier_realtime_connections_closed_total",
      "description": "Closed WebSocket connections by bounded reason.",
      "type": "counter",
      "unit": "connections",
      "labels": ["reason"],
      "cardinalityBudget": 17,
      "source": "gateway connection registry",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp"],
      "stability": "stable",
      "consumers": ["connection dashboard", "disconnect alerts"]
    },
    {
      "name": "cormier_realtime_authentication_total",
      "description": "Authentication outcomes by bounded method.",
      "type": "counter",
      "unit": "attempts",
      "labels": ["method", "outcome"],
      "cardinalityBudget": 8,
      "source": "realtime authenticator",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["security dashboard", "authentication alerts"]
    },
    {
      "name": "cormier_realtime_authorization_failures_total",
      "description": "Authorization failures by bounded operation.",
      "type": "counter",
      "unit": "failures",
      "labels": ["operation"],
      "cardinalityBudget": 5,
      "source": "protocol authorizer",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["security dashboard", "authorization alerts"]
    },
    {
      "name": "cormier_realtime_redis_operations_total",
      "description": "Redis operation outcomes by bounded operation.",
      "type": "counter",
      "unit": "operations",
      "labels": ["operation", "outcome"],
      "cardinalityBudget": 18,
      "source": "Redis adapter",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["Redis dashboard", "Redis alerts"]
    },
    {
      "name": "cormier_realtime_redis_operation_duration_seconds",
      "description": "Redis operation latency.",
      "type": "histogram",
      "unit": "seconds",
      "buckets": [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10, 30, 60, 300],
      "labels": ["operation", "outcome"],
      "cardinalityBudget": 18,
      "source": "Redis adapter",
      "aggregation": "merge buckets across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["Redis dashboard", "latency alerts"]
    },
    {
      "name": "cormier_realtime_handler_duration_seconds",
      "description": "Protocol handler latency.",
      "type": "histogram",
      "unit": "seconds",
      "buckets": [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10, 30, 60, 300],
      "labels": ["operation", "outcome"],
      "cardinalityBudget": 10,
      "source": "protocol handlers",
      "aggregation": "merge buckets across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["latency dashboard", "latency alerts"]
    },
    {
      "name": "cormier_realtime_draining",
      "description": "Whether the gateway is gracefully draining.",
      "type": "gauge",
      "unit": "state",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "gateway lifecycle",
      "aggregation": "max across instances",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["rollout dashboard", "drain alerts"]
    },
    {
      "name": "cormier_realtime_redis_subscription_active",
      "description": "Whether the Redis fan-out subscription is active.",
      "type": "gauge",
      "unit": "state",
      "labels": [],
      "cardinalityBudget": 1,
      "source": "Redis subscriber",
      "aggregation": "minimum across expected instances",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["Redis dashboard", "availability alerts"]
    },
    {
      "name": "cormier_realtime_process_managed_memory_bytes",
      "description": "Managed memory allocated by the process.",
      "type": "gauge",
      "unit": "bytes",
      "labels": [],
      "cardinalityBudget": 1,
      "source": ".NET runtime",
      "aggregation": "sum across instances",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["resource dashboard"]
    },
    {
      "name": "cormier_realtime_process_cpu_seconds_total",
      "description": "Total process CPU time.",
      "type": "counter",
      "unit": "seconds",
      "labels": [],
      "cardinalityBudget": 1,
      "source": ".NET runtime",
      "aggregation": "rate of sum across instances",
      "temporality": "cumulative",
      "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"],
      "stability": "stable",
      "consumers": ["resource dashboard"]
    },
    {
      "name": "cormier_realtime_build_info",
      "description": "Gateway build identity.",
      "type": "gauge",
      "unit": "state",
      "labels": ["version"],
      "cardinalityBudget": 2,
      "source": "assembly metadata",
      "aggregation": "group by version",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp"],
      "stability": "stable",
      "consumers": ["rollout dashboard"]
    },
    {
      "name": "cormier_realtime_topology_info",
      "description": "Configured deployment topology.",
      "type": "gauge",
      "unit": "state",
      "labels": ["mode"],
      "cardinalityBudget": 3,
      "source": "deployment configuration",
      "aggregation": "group by mode",
      "temporality": "current",
      "availability": ["prometheus", "openmetrics", "otlp"],
      "stability": "stable",
      "consumers": ["topology dashboard"]
    },
    { "name": "cormier_realtime_health_requests_total", "description": "Health endpoint requests.", "type": "counter", "unit": "requests", "labels": ["endpoint"], "cardinalityBudget": 3, "source": "health endpoints", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["availability dashboard"] },
    { "name": "cormier_realtime_authentication_failures_total", "description": "Aggregate authentication failures.", "type": "counter", "unit": "failures", "labels": [], "cardinalityBudget": 1, "source": "realtime authenticator", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "diagnostics"], "stability": "stable", "consumers": ["security alerts"] },
    { "name": "cormier_realtime_queue_dropped_total", "description": "Messages rejected by bounded queues.", "type": "counter", "unit": "messages", "labels": [], "cardinalityBudget": 1, "source": "bounded outbound queues", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"], "stability": "stable", "consumers": ["backpressure alerts"] },
    { "name": "cormier_realtime_slow_consumer_disconnects_total", "description": "Clients disconnected after repeated queue saturation.", "type": "counter", "unit": "connections", "labels": [], "cardinalityBudget": 1, "source": "connection registry", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["backpressure alerts"] },
    { "name": "cormier_realtime_heartbeat_timeouts_total", "description": "Connections closed for heartbeat timeout.", "type": "counter", "unit": "connections", "labels": [], "cardinalityBudget": 1, "source": "WebSocket handler", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["connection alerts"] },
    { "name": "cormier_realtime_handshakes_total", "description": "WebSocket handshake outcomes.", "type": "counter", "unit": "attempts", "labels": ["outcome", "reason"], "cardinalityBudget": 13, "source": "WebSocket handler", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["connection dashboard", "security alerts"] },
    { "name": "cormier_realtime_redis_errors_total", "description": "Aggregate failed Redis operations.", "type": "counter", "unit": "errors", "labels": [], "cardinalityBudget": 1, "source": "Redis adapter", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "diagnostics"], "stability": "stable", "consumers": ["Redis alerts"] },
    { "name": "cormier_realtime_websocket_closes_total", "description": "WebSocket closes by bounded status code.", "type": "counter", "unit": "connections", "labels": ["code"], "cardinalityBudget": 12, "source": "WebSocket handler", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["connection dashboard"] },
    { "name": "cormier_realtime_abnormal_websocket_closes_total", "description": "Unexpected WebSocket closes.", "type": "counter", "unit": "connections", "labels": [], "cardinalityBudget": 1, "source": "WebSocket handler", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["connection alerts"] },
    { "name": "cormier_realtime_handler_cancellations_total", "description": "Cancelled protocol handlers.", "type": "counter", "unit": "operations", "labels": [], "cardinalityBudget": 1, "source": "protocol handler", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"], "stability": "stable", "consumers": ["protocol dashboard"] },
    { "name": "cormier_realtime_connection_duration_seconds", "description": "WebSocket connection lifetime.", "type": "histogram", "unit": "seconds", "buckets": [1, 5, 10, 30, 60, 300, 900, 1800, 3600, 7200, 14400, 28800, 86400, 172800, 604800], "labels": ["reason"], "cardinalityBudget": 17, "source": "connection registry", "aggregation": "merge buckets across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["connection dashboard"] },
    { "name": "cormier_realtime_reconnect_authentications_total", "description": "Successful authentications explicitly marked as reconnect attempts by supported clients.", "type": "counter", "unit": "connections", "labels": [], "cardinalityBudget": 1, "source": "realtime authenticator", "aggregation": "rate of sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp", "diagnostics"], "stability": "stable", "consumers": ["reconnect dashboard"] },
    { "name": "cormier_realtime_drain_transitions_total", "description": "Gateway transitions into drain mode.", "type": "counter", "unit": "transitions", "labels": [], "cardinalityBudget": 1, "source": "gateway lifecycle", "aggregation": "sum across instances", "temporality": "cumulative", "availability": ["prometheus", "openmetrics", "otlp"], "stability": "stable", "consumers": ["shutdown diagnostics"] }
  ],
  "prohibitedLabels": [
    "user", "user_id", "tenant", "tenant_id", "session", "session_id", "ticket",
    "topic", "payload", "url", "exception", "connection_id"
  ]
}

{
  "Gateway": {
    "ServiceName": "cormier-realtime-example"
  },
  "Redis": {
    "Endpoint": "127.0.0.1:6379",
    "InstancePrefix": "cormier:realtime:example"
  },
  "Realtime": {
    "EndpointPath": "/realtime/ws",
    "TicketEndpointPath": "/realtime/tickets",
    "SessionSource": "AspNetCoreSession",
    "AspNetCoreSessionIdKey": "Cormier.Realtime.SessionId",
    "AllowedOrigins": [
      "http://127.0.0.1:5080"
    ]
  }
}

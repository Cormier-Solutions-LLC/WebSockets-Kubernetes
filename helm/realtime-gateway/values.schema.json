{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["topology", "image", "service", "deploymentStrategy", "gateway", "redis", "resources"],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": ["metrics"],
        "properties": {
          "metrics": {
            "required": ["enabled", "authorizationPolicy"],
            "properties": {
              "enabled": { "const": true },
              "authorizationPolicy": { "minLength": 1 }
            }
          }
        }
      },
      "then": {
        "required": ["metrics"],
        "properties": {
          "metrics": {
            "required": ["scrapeTokenSecret"],
            "properties": {
              "scrapeTokenSecret": {
                "required": ["name"],
                "properties": { "name": { "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "topology": { "const": "ha" } }, "required": ["topology"] },
      "then": {
        "properties": {
          "replicaCount": { "minimum": 3 },
          "deploymentStrategy": { "properties": { "maxUnavailable": { "const": 0 }, "maxSurge": { "minimum": 1 } } },
          "podDisruptionBudget": { "properties": { "enabled": { "const": true }, "minAvailable": { "minimum": 2 } } },
          "topologySpreadConstraints": { "properties": { "enabled": { "const": true }, "zoneWhenUnsatisfiable": { "const": "DoNotSchedule" } } },
          "autoscaling": { "properties": { "minReplicas": { "minimum": 3 }, "maxReplicas": { "minimum": 3 } } }
        }
      }
    },
    {
      "if": { "properties": { "topology": { "const": "non-ha" } }, "required": ["topology"] },
      "then": {
        "required": ["autoscaling"],
        "properties": {
          "replicaCount": { "const": 1 },
          "podDisruptionBudget": { "properties": { "enabled": { "const": false } } },
          "topologySpreadConstraints": { "properties": { "enabled": { "const": false } } },
          "autoscaling": {
            "required": ["enabled", "minReplicas", "maxReplicas"],
            "properties": { "enabled": { "const": false }, "minReplicas": { "const": 1 }, "maxReplicas": { "const": 1 } }
          }
        }
      }
    }
  ],
  "properties": {
    "topology": { "enum": ["ha", "non-ha"] },
    "topologySpreadConstraints": {
      "type": "object",
      "required": ["enabled", "zoneWhenUnsatisfiable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "zoneWhenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "deploymentStrategy": {
      "type": "object",
      "required": ["maxUnavailable", "maxSurge"],
      "properties": {
          "maxUnavailable": { "type": "integer", "minimum": 0, "maximum": 1 },
          "maxSurge": { "type": "integer", "minimum": 0 }
      },
      "not": {
        "properties": {
          "maxUnavailable": { "const": 0 },
          "maxSurge": { "const": 0 }
        },
        "required": ["maxUnavailable", "maxSurge"]
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      }
    },
    "service": { "type": "object", "required": ["port", "targetPort"], "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "targetPort": { "type": "integer", "minimum": 1024, "maximum": 65535 } } },
    "ingressRoute": {
      "type": "object",
      "required": ["enabled", "entryPoint", "host", "path", "tlsSecretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "entryPoint": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 63 },
        "host": { "type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" },
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
        "tlsSecretName": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["host", "path", "tlsSecretName"], "properties": { "host": { "minLength": 1 }, "tlsSecretName": { "minLength": 1 } } }
        }
      ]
    },
    "gateway": {
      "type": "object",
      "required": ["allowedOrigins", "trustedNetworks", "shutdownDrainSeconds"],
      "properties": {
        "shutdownDrainSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "allowedOrigins": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "trustedNetworks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["enabled", "productionEnabled", "basePath", "authorizationPolicy", "operatorTokenSecret", "allowedOrigins", "allowedNetworks", "logCategoryAllowlist", "maximumDetailItems", "maximumConcurrentRequests", "maximumTailSessions", "tailBufferCapacity", "tailEventsPerSecond", "tailBytesPerSecond", "maximumTailDurationSeconds", "minimumLogOverrideSeconds", "maximumLogOverrideSeconds", "auditCapacity", "auditRetentionDays"],
      "properties": {
        "enabled": { "type": "boolean" },
        "productionEnabled": { "type": "boolean" },
        "basePath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
        "authorizationPolicy": { "type": "string", "maxLength": 128 },
        "operatorTokenSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253 },
            "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 253 }
          }
        },
        "allowedOrigins": { "type": "array", "items": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]+/?$" } },
        "allowedNetworks": { "type": "array", "items": { "type": "string", "pattern": "^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])/(3[0-2]|[12]?[0-9])|((([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,7}:)|(([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2})|(([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3})|(([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4})|(([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5})|([0-9A-Fa-f]{1,4}:((:[0-9A-Fa-f]{1,4}){1,6}))|(:((:[0-9A-Fa-f]{1,4}){1,7}|:)))/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$" } },
        "logCategoryAllowlist": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "maximumDetailItems": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maximumConcurrentRequests": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maximumTailSessions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "tailBufferCapacity": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "tailEventsPerSecond": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "tailBytesPerSecond": { "type": "integer", "minimum": 1024, "maximum": 10485760 },
        "maximumTailDurationSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "minimumLogOverrideSeconds": { "type": "integer", "minimum": 10, "maximum": 300 },
        "maximumLogOverrideSeconds": { "type": "integer", "minimum": 10, "maximum": 86400 },
        "auditCapacity": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "auditRetentionDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "productionEnabled": { "const": true }, "authorizationPolicy": { "minLength": 1 }, "operatorTokenSecret": { "properties": { "name": { "minLength": 1 } } }, "allowedNetworks": { "minItems": 1 } } }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "path", "authorizationPolicy", "scrapeTokenSecret", "allowedNetworks"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
        "authorizationPolicy": { "type": "string", "maxLength": 128 },
        "scrapeTokenSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253 },
            "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 253 }
          }
        },
        "allowedNetworks": { "type": "array", "items": { "type": "string", "pattern": "^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])/(3[0-2]|[12]?[0-9])|((([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,7}:)|(([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2})|(([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3})|(([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4})|(([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5})|([0-9A-Fa-f]{1,4}:((:[0-9A-Fa-f]{1,4}){1,6}))|(:((:[0-9A-Fa-f]{1,4}){1,7}|:)))/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$" } }
      }
    },
    "redis": {
      "type": "object",
      "required": ["mode", "externalEndpoint", "managedReleaseName", "credentialsSecret", "instancePrefix", "username", "sentinelPort", "sentinelServiceName", "managedAdminPasswordKey"],
      "properties": {
        "mode": { "enum": ["external", "managed"] },
        "externalEndpoint": { "type": "string" },
        "managedReleaseName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sentinelPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sentinelServiceName": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "managedAdminPasswordKey": { "type": "string", "minLength": 1 },
        "credentialsSecret": {
          "type": "object",
          "required": ["name", "passwordKey"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "external" } } }, "then": { "properties": { "externalEndpoint": { "minLength": 1 } } } }
      ]
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "connectionsMetric": { "type": "object", "required": ["enabled", "targetAverageValue"], "properties": { "enabled": { "type": "boolean" }, "targetAverageValue": { "type": "string", "pattern": "^[1-9][0-9]*$" } } },
        "queueDepthMetric": { "type": "object", "required": ["enabled", "targetAverageValue"], "properties": { "enabled": { "type": "boolean" }, "targetAverageValue": { "type": "string", "pattern": "^[1-9][0-9]*$" } } }
      }
    },
    "observability": {
      "type": "object",
      "required": ["environment", "cluster", "platformMetrics", "alertThresholds", "links", "serviceMonitor", "otlp", "grafanaDashboard", "prometheusRule", "alertmanagerConfig"],
      "properties": {
        "environment": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "cluster": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "platformMetrics": { "type": "object", "required": ["certificateName", "metalLbAdvertisementMode", "metalLbNamespace", "metalLbAddress", "traefikNamespace", "traefikServicePattern", "redisNamespace", "redisInstance"], "properties": { "certificateName": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "metalLbAdvertisementMode": { "type": "string", "enum": ["l2", "bgp"] }, "metalLbNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "metalLbAddress": { "type": "string", "anyOf": [{ "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})$" }, { "pattern": "^[A-Fa-f0-9]*:[A-Fa-f0-9:]*$" }], "maxLength": 64 }, "traefikNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "traefikServicePattern": { "type": "string", "pattern": "^[A-Za-z0-9._@*|:-]*$", "maxLength": 253 }, "redisNamespace": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }, "redisInstance": { "type": "string", "pattern": "^[A-Za-z0-9._:-]*$", "maxLength": 253 } } },
        "alertThresholds": { "type": "object", "required": ["queueDepth", "handlerLatencySeconds", "redisLatencySeconds", "reconnectRatio"], "properties": { "queueDepth": { "type": "integer", "minimum": 1 }, "handlerLatencySeconds": { "type": "number", "exclusiveMinimum": 0 }, "redisLatencySeconds": { "type": "number", "exclusiveMinimum": 0 }, "reconnectRatio": { "type": "number", "exclusiveMinimum": 0 } } },
        "links": { "type": "object", "required": ["logsUrl", "tracesUrl", "kubernetesUrl", "runbookBaseUrl"], "properties": { "logsUrl": { "type": "string", "format": "uri" }, "tracesUrl": { "type": "string", "format": "uri" }, "kubernetesUrl": { "type": "string", "format": "uri" }, "runbookBaseUrl": { "type": "string", "format": "uri" } } },
        "serviceMonitor": { "type": "object", "required": ["enabled", "interval", "scrapeTimeout"], "properties": { "enabled": { "type": "boolean" }, "interval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" }, "scrapeTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" } } },
        "otlp": { "type": "object", "required": ["enabled", "endpoint", "protocol", "egressNamespaceSelector", "egressPodSelector", "egressCidrs", "egressPorts", "headersSecret"], "properties": { "enabled": { "type": "boolean" }, "endpoint": { "type": "string", "pattern": "^$|^https?://" }, "protocol": { "type": "string", "enum": ["http/protobuf", "grpc"] }, "egressNamespaceSelector": { "type": "object" }, "egressPodSelector": { "type": "object" }, "egressCidrs": { "type": "array", "items": { "type": "string", "pattern": "^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])/(3[0-2]|[12]?[0-9])|((([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,7}:)|(([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2})|(([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3})|(([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4})|(([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5})|([0-9A-Fa-f]{1,4}:((:[0-9A-Fa-f]{1,4}){1,6}))|(:((:[0-9A-Fa-f]{1,4}){1,7}|:)))/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$" } }, "egressPorts": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }, "headersSecret": { "type": "object", "required": ["name", "key"], "properties": { "name": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }, "key": { "type": "string", "minLength": 1 } } } }, "allOf": [{ "if": { "properties": { "enabled": { "const": true } } }, "then": { "properties": { "endpoint": { "minLength": 1 } } } }] },
        "grafanaDashboard": { "type": "object", "required": ["enabled", "label", "labelValue"], "properties": { "enabled": { "type": "boolean" }, "label": { "type": "string", "minLength": 1 }, "labelValue": { "type": "string", "minLength": 1 } } },
        "prometheusRule": { "type": "object", "required": ["enabled", "ingressEnabled", "routingLabels"], "properties": { "enabled": { "type": "boolean" }, "ingressEnabled": { "type": "boolean" }, "routingLabels": { "type": "object", "required": ["service"], "properties": { "service": { "type": "string" } }, "additionalProperties": { "type": "string", "minLength": 1 } } } },
        "alertmanagerConfig": { "type": "object", "required": ["enabled", "receiverName", "webhookSecret"], "properties": { "enabled": { "type": "boolean" }, "receiverName": { "type": "string", "minLength": 1 }, "webhookSecret": { "type": "object", "required": ["name", "key"], "properties": { "name": { "type": "string" }, "key": { "type": "string", "minLength": 1 } } } } }
      }
    }
  }
}

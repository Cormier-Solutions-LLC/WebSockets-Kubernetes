{
	auto_https off
	admin off
	log default {
		output discard
	}
	servers {
		timeouts {
			read_header 5s
			read_body 15s
			write 30s
			idle 60s
		}
	}
}

http://:{$PORT} {
	bind {$LISTEN_HOST}
	log {
		output discard
	}
	header {
		-X-Powered-By
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self'; style-src 'self'; script-src 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	@realtime_websocket path /realtime/ws
	reverse_proxy @realtime_websocket {$GATEWAY_URL} {
		header_up Host {http.request.hostport}
		header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
	}
	@realtime_ticket path /realtime/tickets
	request_body @realtime_ticket {
		max_size 65536
	}
	root * {$PUBLIC_ROOT}
	php_server
}

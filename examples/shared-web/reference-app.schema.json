{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cormier.example/schemas/reference-app.schema.json",
  "title": "Cormier.Realtime reference application environment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "LISTEN_HOST",
    "PORT",
    "PUBLIC_ORIGIN",
    "GATEWAY_URL",
    "REDIS_URL",
    "SESSION_LIFETIME_SECONDS",
    "INSTANCE_NAME",
    "TOPOLOGY",
    "REDIS_INSTANCE_PREFIX",
    "REDIS_SESSION_KEY_PREFIX",
    "ALLOWED_TENANTS",
    "ALLOWED_USERS"
  ],
  "properties": {
    "LISTEN_HOST": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,253}$" },
    "TRUST_PROXY_HOPS": { "type": "string", "pattern": "^(?:[0-9]|1[0-6])$" },
    "PORT": { "$ref": "#/$defs/port" },
    "APPLICATION_HOST": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,253}$" },
    "APPLICATION_PORT": { "$ref": "#/$defs/port" },
    "APP_URL": { "$ref": "#/$defs/httpUpstream" },
    "PUBLIC_ROOT": { "type": "string", "minLength": 1 },
    "PUBLIC_ORIGIN": { "$ref": "#/$defs/httpOrigin" },
    "GATEWAY_URL": { "$ref": "#/$defs/httpOrigin" },
    "REDIS_URL": { "$ref": "#/$defs/redisUrl" },
    "SESSION_SECRET": { "type": "string", "minLength": 32, "maxLength": 4096, "pattern": "^[!-~]{32,4096}(?![\\s\\S])" },
    "SESSION_LIFETIME_SECONDS": { "$ref": "#/$defs/sessionLifetime" },
    "INSTANCE_NAME": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "TOPOLOGY": { "enum": ["non-ha", "ha"] },
    "REDIS_INSTANCE_PREFIX": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "REDIS_SESSION_KEY_PREFIX": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "ALLOWED_TENANTS": { "$ref": "#/$defs/allowlist" },
    "ALLOWED_USERS": { "$ref": "#/$defs/allowlist" }
  },
  "$defs": {
    "allowlist": {
      "type": "string",
      "pattern": "^[\\t ]*[A-Za-z0-9._-]{1,128}(?:[\\t ]*,[\\t ]*[A-Za-z0-9._-]{1,128})*[\\t ]*$"
    },
    "port": {
      "type": "string",
      "pattern": "^(?:10(?:2[4-9]|[3-9][0-9])|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65(?:[0-4][0-9]{2}|5(?:[0-2][0-9]|3[0-5])))$"
    },
    "redisUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^rediss?://(?:[^/?#]+@)?(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:.]+\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[0-9]*)?(?![\\s\\S])"
    },
    "sessionLifetime": {
      "type": "string",
      "pattern": "^(?:[6-9][0-9]|[1-9][0-9]{2}|[1-6][0-9]{3}|7(?:[01][0-9]{2}|200))$"
    },
    "httpOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?!(?:[0-9]+\\.){3}[0-9]+(?=[:/]|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*|\\[(?:(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|(?=(?:[0-9a-f]{0,4}:){2,7}[0-9a-f]{0,4}\\])(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4})*)?::(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4})*)?)\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?(?![\\s\\S])",
      "not": {
        "anyOf": [
          { "pattern": "^http://(?:[^/]+):80/?$" },
          { "pattern": "^https://(?:[^/]+):443/?$" }
        ]
      }
    },
    "httpUpstream": {
      "allOf": [
        { "$ref": "#/$defs/httpOrigin" },
        { "type": "string", "pattern": "^http://" }
      ]
    }
  }
}

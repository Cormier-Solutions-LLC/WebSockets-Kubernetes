{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: .NET solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Cormier.Realtime.sln", "-p:RestoreLockedMode=true"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build: load runner",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/tools/Cormier.Realtime.LoadRunner/Cormier.Realtime.LoadRunner.csproj", "-p:RestoreLockedMode=true"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Swift Vapor",
      "type": "process",
      "command": "swift",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}/examples/swift-vapor" },
      "problemMatcher": []
    },
    {
      "label": "serve: browser example",
      "type": "process",
      "command": "python",
      "args": ["-m", "http.server", "8000", "--bind", "127.0.0.1", "--directory", "${workspaceFolder}"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "browser-example",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Serving HTTP on.*"
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/cormier/realtime/bootstrap/v1",
  "title": "Cormier.Realtime bootstrap configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "naming", "paths", "image", "kubernetes", "networking", "redis", "ingress", "observability", "resources", "topology"],
  "allOf": [
    {
      "if": { "properties": { "redis": { "properties": { "mode": { "const": "managed" } } } } },
      "then": { "properties": { "redis": { "properties": { "tls": { "const": false } } } } }
    },
    {
      "if": { "properties": { "redis": { "properties": { "mode": { "const": "external" } } } } },
      "then": { "properties": { "redis": { "properties": { "externalEgressCidrs": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "observability": { "properties": { "serviceMonitor": { "const": true } } } } },
      "then": { "properties": { "observability": { "properties": { "monitoringNamespaceLabels": { "minProperties": 1 }, "monitoringPodLabels": { "minProperties": 1 } } } } }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]{1,10}$" },
        "class": { "enum": ["development", "test", "staging", "production"] }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suffix"],
      "properties": { "suffix": { "type": "string", "pattern": "^$|^(?=.{1,27}$)[a-z0-9]+(?:-[a-z0-9]+)*$" } }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedDirectory", "backupDirectory", "logDirectory"],
      "properties": {
        "generatedDirectory": { "type": "string", "pattern": "^\\.bootstrap(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$" },
        "backupDirectory": { "type": "string", "pattern": "^\\.backups(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$" },
        "logDirectory": { "type": "string", "pattern": "^\\.logs(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9.-]+(?::[0-9]+)?(?:/[a-z0-9._-]+)+$" },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "namespace", "storageClass", "failureDomains"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "storageClass": { "type": "string", "minLength": 1 },
        "failureDomains": { "type": "integer", "minimum": 1 }
      }
    },
    "networking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traefikNamespace", "traefikService", "traefikPodLabels", "metalLbNamespace", "metalLbAddress", "advertisementMode"],
      "properties": {
        "traefikNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "traefikService": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "traefikPodLabels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "metalLbNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "metalLbAddress": { "type": "string", "pattern": "^[A-Fa-f0-9:.]+$" },
        "advertisementMode": { "enum": ["l2", "bgp"] }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "externalEndpoint", "externalHaConfirmed", "externalEgressCidrs", "tls", "credentialsSecret", "credentialKey", "adminCredentialKey", "username", "instancePrefix"],
      "properties": {
        "mode": { "enum": ["external", "managed"] },
        "externalEndpoint": { "type": "string" },
        "externalHaConfirmed": { "type": "boolean" },
        "externalEgressCidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$" } },
        "tls": { "type": "boolean" },
        "credentialsSecret": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "credentialKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "adminCredentialKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "username": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "instancePrefix": { "type": "string", "pattern": "^[A-Za-z0-9:_-]+$" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "allowedOrigins", "entryPoint", "tlsSecretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "pattern": "^$|^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$" },
        "allowedOrigins": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://[^/?#]+/?$" } },
        "entryPoint": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "tlsSecretName": { "type": "string" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceMonitor", "monitoringNamespaceLabels", "monitoringPodLabels", "otlpEndpoint", "otlpHeadersSecret", "otlpHeadersKey", "otlpEgressCidrs", "otlpEgressNamespaceLabels", "otlpEgressPodLabels", "otlpEgressPorts"],
      "properties": {
        "serviceMonitor": { "type": "boolean" },
        "monitoringNamespaceLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "monitoringPodLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "otlpEndpoint": { "type": "string" },
        "otlpHeadersSecret": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "otlpHeadersKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "otlpEgressCidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$" } },
        "otlpEgressNamespaceLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "otlpEgressPodLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "otlpEgressPorts": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gatewayCpu", "gatewayMemory", "redisStorage"],
      "properties": {
        "gatewayCpu": { "type": "string", "pattern": "^[1-9][0-9]*m$" },
        "gatewayMemory": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
        "redisStorage": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
      }
    },
    "topology": { "enum": ["ha", "non-ha"] }
  }
}

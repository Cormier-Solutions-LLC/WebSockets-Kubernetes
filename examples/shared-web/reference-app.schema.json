{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cormier.example/schemas/reference-app.schema.json",
  "title": "Cormier.Realtime reference application environment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "LISTEN_HOST",
    "PORT",
    "PUBLIC_ORIGIN",
    "GATEWAY_URL",
    "REDIS_URL",
    "SESSION_LIFETIME_SECONDS",
    "INSTANCE_NAME",
    "TOPOLOGY",
    "REDIS_INSTANCE_PREFIX",
    "REDIS_SESSION_KEY_PREFIX",
    "ALLOWED_TENANTS",
    "ALLOWED_USERS"
  ],
  "properties": {
    "LISTEN_HOST": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,253}$" },
    "TRUST_PROXY_HOPS": { "type": "string", "pattern": "^(?:[0-9]|1[0-6])$" },
    "PORT": { "type": "string", "pattern": "^[0-9]+$" },
    "APPLICATION_HOST": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,253}$" },
    "APPLICATION_PORT": { "type": "string", "pattern": "^[0-9]+$" },
    "APP_URL": { "type": "string", "format": "uri" },
    "PUBLIC_ROOT": { "type": "string", "minLength": 1 },
    "PUBLIC_ORIGIN": { "$ref": "#/$defs/httpOrigin" },
    "GATEWAY_URL": { "$ref": "#/$defs/httpOrigin" },
    "REDIS_URL": { "type": "string", "format": "uri" },
    "SESSION_SECRET": { "type": "string", "minLength": 32, "maxLength": 4096 },
    "SESSION_LIFETIME_SECONDS": { "type": "string", "pattern": "^[0-9]+$" },
    "INSTANCE_NAME": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "TOPOLOGY": { "enum": ["non-ha", "ha"] },
    "REDIS_INSTANCE_PREFIX": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "REDIS_SESSION_KEY_PREFIX": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "ALLOWED_TENANTS": { "type": "string" },
    "ALLOWED_USERS": { "type": "string" }
  },
  "$defs": {
    "httpOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:.]+\\])(?::[0-9]{1,5})?/?$",
      "not": {
        "anyOf": [
          { "pattern": "^http://(?:[^/]+):80/?$" },
          { "pattern": "^https://(?:[^/]+):443/?$" }
        ]
      }
    }
  }
}
